FROM node:22-alpine

WORKDIR /app

# Copy dependencies first to leverage Docker cache
COPY package.json package-lock.json ./

# Install dependencies including dev dependencies inside the container
RUN set -e; \
    echo "[Docker build] Starting dependency installation"; \
    if [ -f yarn.lock ]; then \
        echo "[Docker build] Using yarn.lock"; \
        yarn install; \
    elif [ -f package-lock.json ]; then \
        echo "[Docker build] Using package-lock.json"; \
        npm ci; \
    elif [ -f pnpm-lock.yaml ]; then \
        echo "[Docker build] Using pnpm-lock.yaml"; \
        corepack enable pnpm && pnpm install; \
    else \
        echo "[Docker build] No lockfile found, falling back to npm install"; \
        npm install; \
    fi

# Copy the rest of the application code
RUN echo "[Docker build] Copying application source files"
COPY . .

# Expose the port the app runs on
EXPOSE 3000

# Start the application with hot reloading enabled for development
CMD ["sh", "-c", "echo '[Docker run] Starting development server'; npm run dev"]
